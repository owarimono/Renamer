{
  "name": "auto-renamer",
  "version": "1.0.0",
  "description": "Auto-rename files copied into a watched folder",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.renamer.autorenamer",
    "productName": "Auto Renamer",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "i18n.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "chokidar": "3.6.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "24.13.3"
  }
}
